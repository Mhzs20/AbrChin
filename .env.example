# Development
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/abrchin?schema=public
SESSION_SECRET=
# 32 random bytes encoded as base64, used only for one-time credential delivery.
CREDENTIAL_ENCRYPTION_KEY=

# SMS: console | kavenegar. Connection Check only validates configuration; it never sends a test OTP.
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=abrchinlogin
KAVENEGAR_ALERT_TEMPLATE=abrchinops
KAVENEGAR_TIMEOUT_MS=8000

# Payments (secrets only in env — never in DB/API/UI). Connection Check is non-financial and validates configuration only.
PAYMENT_CALLBACK_BASE_URL=http://localhost:3010
PAYMENT_BOOTSTRAP_DEFAULT_PROVIDER=zibal

ZIBAL_MERCHANT=
ZIBAL_TIMEOUT_MS=10000

ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_TIMEOUT_MS=10000

# Comma-separated admin mobiles (09xxxxxxxxx)
ADMIN_MOBILES=

OTP_TTL_SECONDS=120
SESSION_TTL_DAYS=30

# MessageGo product credential. Provider API keys remain only on MessageGo.
MESSAGEGO_BASE_URL=https://aichin.abrchin.ir
MESSAGEGO_CLIENT_ID=abrchin-development
MESSAGEGO_CLIENT_SECRET=
MESSAGEGO_TENANT_ID=abrchin
MESSAGEGO_WORKSPACE_ID=development
MESSAGEGO_TIMEOUT_MS=15000
# Local/test-only MessageGo settlement candidate. Never a production lock.
# Production MessageGo AI, settlement, customer AI UX, and secret handoff
# stay denied even if this is set. Deprecated MESSAGEGO_V2_* names are rejected.
MESSAGEGO_SETTLEMENT_SERVICE_CREDENTIAL=
MESSAGEGO_SETTLEMENT_ENABLED=false
MESSAGEGO_CUSTOMER_AI_ENABLED=false
MESSAGEGO_SECRET_HANDOFF_ENABLED=false
MESSAGEGO_HANDOFF_BASE_URL=
MESSAGEGO_HANDOFF_PATH=/internal/v2/handoff

# Email delivery: console | smtp. Connection Check / verification never succeeds silently without delivery.
# Production MUST use EMAIL_PROVIDER=smtp with real SMTP credentials.
EMAIL_PROVIDER=console
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_MS=10000
EMAIL_VERIFICATION_TTL_SECONDS=600

# Reverse proxy trust (number of hops from client to app)
TRUSTED_PROXY_HOPS=0

# Infrastructure provider: mock (ArvanCloud uses its own adapter and is not selected here)
INFRASTRUCTURE_PROVIDER_MODE=mock
# Founder policy: public sale stays open; sellability still requires a
# published offer with valid stock, region and fresh pricing.
PUBLIC_SALE_ENABLED=true

# ArvanCloud IaaS v1: CLOUD_SERVER catalog. The adapter also accepts a URL
# ending in /regions and normalizes it to the ECC v1 root.
ARVAN_ENABLED=false
ARVAN_API_KEY=
ARVAN_API_BASE_URL=https://napi.arvancloud.ir/ecc/v1
ARVAN_API_VERSION=v1
# Required when ARVAN_ENABLED=true. Server-owned allowlist; no API discovery fallback.
ARVAN_REGION_CODES=ir-thr-si1,ir-thr-fr1,ir-tbz-sh1,ir-thr-ba1,ir-southwest1-a,eu-west1-a
ARVAN_TIMEOUT_MS=15000
ARVAN_GET_ATTEMPTS=3
# Published provider/source offers are sale-enabled by default.
ARVAN_PUBLIC_SALE_ENABLED=true
ARVAN_READY_PUBLIC_SALE_ENABLED=true
ARVAN_CLOUD_PUBLIC_SALE_ENABLED=true
# Independent sale gate for Admin-managed ready inventory.
MANUAL_READY_PUBLIC_SALE_ENABLED=true
# Keep false. A separately approved staging exercise is required before any
# Arvan lifecycle mutation can be enabled.
ARVAN_MUTATIONS_ENABLED=false
CATALOG_SYNC_INTERVAL_MS=300000

# Provisioning worker
WORKER_POLL_MS=3000
WORKER_LEASE_MS=120000
WORKER_STALE_AFTER_MS=60000
WORKER_ID=provisioning-worker-dev
WORKER_MAX_IDLE_ROUNDS=0
# Retry-safe hourly/daily settlement scheduler; minimum accepted value is 60000.
BILLING_WORKER_INTERVAL_MS=60000
