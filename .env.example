# Development
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/abrchin?schema=public
SESSION_SECRET=

# SMS: console | kavenegar
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=abrchinlogin
KAVENEGAR_TIMEOUT_MS=8000

# Payments (secrets only in env — never in DB/API/UI)
PAYMENT_CALLBACK_BASE_URL=http://localhost:3010
PAYMENT_BOOTSTRAP_DEFAULT_PROVIDER=zibal

ZIBAL_MERCHANT=
ZIBAL_TIMEOUT_MS=10000

ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_TIMEOUT_MS=10000

# Comma-separated admin mobiles (09xxxxxxxxx)
ADMIN_MOBILES=

OTP_TTL_SECONDS=120
SESSION_TTL_DAYS=30

# Reverse proxy trust (number of hops from client to app)
TRUSTED_PROXY_HOPS=0

# Infrastructure provider: mock | parspack
INFRASTRUCTURE_PROVIDER_MODE=mock
PARSPACK_ENABLED=false
PARSPACK_API_BASE_URL=https://my.parspack.com/cserver/api/v1
PARSPACK_API_TOKEN=
PARSPACK_TIMEOUT_MS=15000

# Provisioning worker
WORKER_POLL_MS=3000
WORKER_LEASE_MS=120000
WORKER_STALE_AFTER_MS=60000
WORKER_ID=provisioning-worker-dev
WORKER_MAX_IDLE_ROUNDS=0
