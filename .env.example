# Local PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/abrchin?schema=public

# Random secret used when hashing session tokens (min 32 chars recommended)
SESSION_SECRET=

# SMS provider: console | (future real providers)
SMS_PROVIDER=console

# Reserved for a future real SMS provider
SMS_API_KEY=
SMS_SENDER=

# OTP lifetime in seconds (default: 120)
OTP_TTL_SECONDS=120

# Session lifetime in days (default: 30)
SESSION_TTL_DAYS=30
