# Production placeholders only — never commit real secrets
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/abrchin?schema=public
SESSION_SECRET=
# 32 random bytes encoded as base64; keep outside git and application-data backups.
CREDENTIAL_ENCRYPTION_KEY=

SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=abrchinlogin
KAVENEGAR_ALERT_TEMPLATE=abrchinops
KAVENEGAR_TIMEOUT_MS=8000

PAYMENT_CALLBACK_BASE_URL=https://abrchin.ir
PAYMENT_BOOTSTRAP_DEFAULT_PROVIDER=zibal

ZIBAL_MERCHANT=
ZIBAL_TIMEOUT_MS=10000

ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
ZARINPAL_TIMEOUT_MS=10000

ADMIN_MOBILES=

OTP_TTL_SECONDS=120
SESSION_TTL_DAYS=30

# Reverse proxy trust (typically 1 behind nginx)
TRUSTED_PROXY_HOPS=1

# Infrastructure provider
INFRASTRUCTURE_PROVIDER_MODE=parspack
PARSPACK_ENABLED=false
PARSPACK_PUBLIC_SALE_ENABLED=false
PARSPACK_API_BASE_URL=https://my.parspack.com/cserver/api/public/v1
PARSPACK_MANAGEMENT_API_BASE_URL=https://my.parspack.com/cserver/api/v1
# Deprecated compatibility alias; leave empty on new installations.
PARSPACK_PUBLIC_API_BASE_URL=
PARSPACK_API_TOKEN=
PARSPACK_TIMEOUT_MS=15000
# Fail-closed price contract. Do not populate from guesswork.
PARSPACK_PRICE_CURRENCY=
PARSPACK_PRICE_AMOUNT_UNIT=
PARSPACK_API_VERSION=v1

ARVAN_ENABLED=false
ARVAN_API_KEY=
ARVAN_API_BASE_URL=https://napi.arvancloud.ir/ecc/v1
ARVAN_API_VERSION=v1
ARVAN_REGION_CODES=ir-thr-si1,ir-thr-fr1,ir-tbz-sh1,ir-thr-ba1,ir-southwest1-a,eu-west1-a
ARVAN_TIMEOUT_MS=15000
ARVAN_GET_ATTEMPTS=3
ARVAN_PUBLIC_SALE_ENABLED=false
ARVAN_MUTATIONS_ENABLED=false
CATALOG_SYNC_INTERVAL_MS=300000

# Provisioning worker (never pass PARSPACK_API_TOKEN as build arg)
WORKER_POLL_MS=3000
WORKER_LEASE_MS=120000
WORKER_STALE_AFTER_MS=60000
WORKER_ID=provisioning-worker

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
ABRCHIN_IMAGE=
