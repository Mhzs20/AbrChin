    "test:connection-check": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test scripts/arvan-connection-check-test.mts",
    "test:catalog-sync": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test scripts/catalog-sync-test.mts",
