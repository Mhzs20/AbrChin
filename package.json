    "test:readiness": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test scripts/product-flow-test.mts",
    "test:account-admin": "node --experimental-strip-types --test scripts/account-admin-test.mts",
    "test:panel-role-e2e": "node --experimental-strip-types --test --test-concurrency=1 scripts/panel-role-e2e-test.mts",
    "test:recommendation": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test scripts/recommendation-test.mts scripts/provider-ranking-test.mts scripts/product-flow-test.mts scripts/quick-buy-test.mts scripts/ready-cloud-servers-test.mts scripts/credential-vault-test.mts scripts/subscription-test.mts scripts/storefront-dominance-parchin-test.mts scripts/delivery-os-ssh-ux-test.mts",
    "test:providers": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test scripts/multi-provider-test.mts scripts/provider-flow-behavior-test.mts scripts/review-hardening-test.mts",
    "test:postgres": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types scripts/postgres-migration-test.mts",
    "preflight:1r": "node --experimental-strip-types scripts/preflight-1r.mts",
    "integration:parspack": "npm run sync:catalog:parspack",
    "probe:parspack:source": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types scripts/parspack-probe.mts",
    "test:all": "npm run lint && npm run test:auth && npm run test:wallet && npm run test:billing-policy && npm run test:customer-navigation && npm run test:connection-check && npm run test:payments && npm run test:infrastructure && npm run test:account-admin && npm run test:recommendation && npm run test:providers && npm run test:profit-curve && npm run test:accounting && npm run build && npm run test:panel-role-e2e && npm run test:worker-runtime && npm run test:smoke && git diff --check",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "accounting:backfill": "node dist/accounting/accounting-backfill.js",
    "accounting:backfill:source": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types scripts/accounting-backfill.mts"
