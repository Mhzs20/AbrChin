{
  "name": "abrchin-homepage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "prisma generate && node scripts/build-worker.mjs && next build",
    "build:worker": "node scripts/build-worker.mjs",
    "sync:catalog:parspack": "node dist/catalog-sync/catalog-sync.js parspack",
    "sync:catalog:arvan": "node dist/catalog-sync/catalog-sync.js arvan",
    "sync:catalog:all": "node dist/catalog-sync/catalog-sync.js all",
    "start:catalog-sync-scheduler": "node dist/catalog-sync/catalog-sync-scheduler.js",
    "start": "next start -p 3010",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:auth": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test scripts/auth-unit-test.mts scripts/auth-integration-test.mts scripts/kavenegar-sms-test.mts scripts/release-blocker-security-test.mts scripts/customer-journey-ux-test.mts",
    "test:wallet": "node --experimental-strip-types --test scripts/wallet-test.mts",
    "test:subscription": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test scripts/subscription-test.mts",
    "test:wallet-recovery": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test --test-concurrency=1 scripts/wallet-payment-recovery-postgres-test.mts",
    "test:billing-worker": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test --test-concurrency=1 scripts/billing-worker-postgres-test.mts",
