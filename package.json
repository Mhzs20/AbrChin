  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "1.25.0",
    "motion": "^12.42.2",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "prisma": "^6.19.3",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "8.5.10",
    "sharp": "0.35.0"
  }
}
