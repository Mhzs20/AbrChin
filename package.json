{
  "name": "abrchin-homepage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "prisma generate && next build",
    "start": "next start -p 3010",
    "lint": "eslint .",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:auth": "node --experimental-strip-types --test scripts/auth-unit-test.mts scripts/auth-integration-test.mts scripts/kavenegar-sms-test.mts",
    "test:wallet": "node --experimental-strip-types --test scripts/wallet-test.mts",
    "test:payments": "node --experimental-strip-types --test scripts/payments-test.mts",
    "test:all": "npm run lint && npm run test:auth && npm run test:wallet && npm run test:payments && npm run build && npm run test:smoke && git diff --check",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "1.25.0",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "prisma": "^6.19.3",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "8.5.10",
    "sharp": "0.35.0"
  }
}
