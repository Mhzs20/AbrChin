    "test:customer-navigation": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test scripts/customer-wallet-navigation-test.mts scripts/wallet-first-checkout-test.mts",
    "test:delivery-credential": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test --test-concurrency=1 scripts/delivery-credential-postgres-test.mts",
    "test:admin-operations": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test --test-concurrency=1 scripts/admin-operations-postgres-test.mts",
    "test:financial-postgres": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types scripts/financial-postgres-test.mts",
    "test:finance-config": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test --test-concurrency=1 scripts/finance-configuration-postgres-test.mts",
    "test:finance-config-isolated": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types scripts/finance-configuration-isolated-test.mts",
    "test:profit-curve": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test scripts/profit-curve-test.mts scripts/audit-adversarial-finance-test.mts",
    "test:accounting": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test scripts/accounting-test.mts scripts/audit-adversarial-finance-test.mts",
    "test:accounting-postgres": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test --test-concurrency=1 scripts/accounting-postgres-test.mts",
