{
  "name": "abrchin-homepage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "prisma generate && node scripts/build-worker.mjs && next build",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start -p 3010",
    "lint": "eslint .",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:auth": "node --experimental-strip-types --test scripts/auth-unit-test.mts scripts/auth-integration-test.mts scripts/kavenegar-sms-test.mts",
    "test:wallet": "node --experimental-strip-types --test scripts/wallet-test.mts",
    "test:wallet-recovery": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test --test-concurrency=1 scripts/wallet-payment-recovery-postgres-test.mts",
    "test:billing-worker": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test --test-concurrency=1 scripts/billing-worker-postgres-test.mts",
    "test:billing-policy": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test scripts/billing-policy-test.mts",
    "test:wallet-activation": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test --test-concurrency=1 scripts/wallet-activation-postgres-test.mts",
    "test:customer-navigation": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test scripts/customer-wallet-navigation-test.mts",
    "test:delivery-credential": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test --test-concurrency=1 scripts/delivery-credential-postgres-test.mts",
    "test:admin-operations": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test --test-concurrency=1 scripts/admin-operations-postgres-test.mts",
    "test:payments": "node --experimental-strip-types --test scripts/payments-test.mts",
    "test:infrastructure": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test --test-concurrency=1 scripts/infrastructure-test.mts scripts/worker-test.mts scripts/production-hardening-test.mts scripts/parspack-contract-test.mts scripts/provider-pricing-test.mts scripts/migration-safety-test.mts",
    "test:worker-runtime": "node --experimental-strip-types --test scripts/worker-runtime-test.mts",
    "test:account-admin": "node --experimental-strip-types --test scripts/account-admin-test.mts",
    "test:panel-role-e2e": "node --experimental-strip-types --test --test-concurrency=1 scripts/panel-role-e2e-test.mts",
    "test:recommendation": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test scripts/recommendation-test.mts scripts/provider-ranking-test.mts scripts/product-flow-test.mts scripts/quick-buy-test.mts scripts/ready-cloud-servers-test.mts scripts/credential-vault-test.mts scripts/subscription-test.mts",
    "test:providers": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types --test scripts/multi-provider-test.mts scripts/provider-flow-behavior-test.mts scripts/review-hardening-test.mts",
    "test:postgres": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types scripts/postgres-migration-test.mts",
    "integration:parspack": "node --import ./scripts/test-resolve-hook.mjs --experimental-strip-types scripts/parspack-probe.mts",
    "test:all": "npm run lint && npm run test:auth && npm run test:wallet && npm run test:payments && npm run test:infrastructure && npm run test:account-admin && npm run test:panel-role-e2e && npm run test:recommendation && npm run test:providers && npm run build && npm run test:worker-runtime && npm run test:smoke && git diff --check",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "1.25.0",
    "motion": "^12.42.2",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "prisma": "^6.19.3",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "8.5.10",
    "sharp": "0.35.0"
  }
}
