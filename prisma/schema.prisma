}

model ProductPricingConfig {
  id                String                    @id @default(cuid())
  provider          InfrastructureProvider
  apiVersion        String                    @default("v1")
  productKind       InfrastructureProductKind
  /// Keep product markup at 0 by default so provider markup alone owns the 30/70 split.
  markupBasisPoints Int                       @default(0)
  enabled           Boolean                   @default(false)
  updatedById       String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([provider, apiVersion, productKind])
  @@index([productKind, enabled])
}

model Coupon {
  id              String             @id @default(cuid())
  code            String             @unique
  type            CouponType
  scope           CouponScope        @default(PUBLIC)
  userId          String?
  discountBps     Int?
  termMonths      Int?
  minDepositRial  BigInt?
  bonusRial       BigInt?
  expiresAt       DateTime?
  maxRedemptions  Int?
  redemptionCount Int                @default(0)
  active          Boolean            @default(true)
  createdById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User?              @relation("CouponForUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy       User?              @relation("CouponCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  redemptions     CouponRedemption[]

  @@index([type, active, expiresAt])
  @@index([userId, active])
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  userId         String
  serviceOrderId String?
  walletTopUpId  String?
  amountRial     BigInt   @default(0)
  bonusRial      BigInt   @default(0)
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@index([walletTopUpId])
  @@index([serviceOrderId])
}

model CommercePricingConfig {
  id                                String   @id @default("default")
  taxBps                            Int      @default(1000)
  reminderDaysBeforeDue             Int      @default(7)
  suspendGraceDaysAfterZero         Int      @default(7)
  deleteDaysAfterSuspend            Int      @default(7)
  /// Floor gross margin (bps) after discount on infrastructure economics.
  minimumPostDiscountGrossMarginBps Int      @default(2000)
  /// Admin-priced Compass service packages (code -> rial string).
  compassServicePrices              Json     @default("{}")
  updatedById                       String?
  updatedAt                         DateTime @updatedAt
}

model ParchinPricingConfig {
  id                  String       @id @default(cuid())
  level               ParchinLevel @unique
  /// Monotonic service-contract version. Admin edits bump this; Quote/Order keep snapshots.
  version             Int          @default(1)
  title               String
  subtitle            String?
  description         String?
  priceRial           BigInt
  includedServices    Json         @default("[]")
  excludedServices    Json         @default("[]")
  serviceLimits       Json         @default("{}")
  supportWindow       String?
  firstResponseTarget String?
  active              Boolean      @default(true)
  effectiveFrom       DateTime     @default(now())
  sortOrder           Int          @default(0)
  updatedById         String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

/// Active, versioned Parchin contract created atomically with secure delivery.
model ParchinEnrollment {
  id                  String                  @id @default(cuid())
  userId              String
  cloudInstanceId     String                  @unique
  serviceOrderId      String                  @unique
  subscriptionId      String?                 @unique
  level               ParchinLevel
  contractVersion     Int
  contractSnapshot    Json
  status              ParchinEnrollmentStatus @default(ACTIVE)
  supportWindow       String
  firstResponseTarget String
  routineRequestLimit Int
  routineRequestsUsed Int                     @default(0)
  quotaPeriodStart    DateTime
  quotaPeriodEnd      DateTime
  requestedNextLevel  ParchinLevel?
  requestedLevelAt    DateTime?
  activatedAt         DateTime                @default(now())
  endedAt             DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  user                User                    @relation("ParchinCustomer", fields: [userId], references: [id], onDelete: Cascade)
  cloudInstance       CloudInstance           @relation(fields: [cloudInstanceId], references: [id], onDelete: Cascade)
  serviceOrder        ServiceOrder            @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  subscription        ServiceSubscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  tasks               ParchinTask[]
  reports             ParchinReport[]
  supportRequests     SupportRequest[]

  @@index([status, level])
  @@index([userId, status])
  @@index([quotaPeriodEnd])
}

/// Human-operable Parchin commitment with durable owner, due time and evidence.
model ParchinTask {
  id              String                @id @default(cuid())
  enrollmentId    String
  type            ParchinTaskType
  templateKey     String
  title           String
  description     String
  status          ParchinTaskStatus     @default(TODO)
  priority        ParchinTaskPriority   @default(NORMAL)
  recurrence      ParchinTaskRecurrence @default(ONCE)
  dueAt           DateTime
  assignedToId    String?
  completedById   String?
  startedAt       DateTime?
  completedAt     DateTime?
  evidenceSummary String?
  evidence        Json?
  blockedReason   String?
  idempotencyKey  String                @unique
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  enrollment      ParchinEnrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  assignedTo      User?                 @relation("ParchinTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  completedBy     User?                 @relation("ParchinTaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([enrollmentId, status, dueAt])
  @@index([assignedToId, status, dueAt])
  @@index([priority, status, dueAt])
}

/// Customer-visible operational output produced from completed Parchin work.
model ParchinReport {
  id              String              @id @default(cuid())
  enrollmentId    String
  type            ParchinReportType
  status          ParchinReportStatus @default(DRAFT)
  title           String
  summary         String
  periodStart     DateTime
  periodEnd       DateTime
  metrics         Json                @default("{}")
  recommendations Json                @default("[]")
  createdById     String
  publishedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  enrollment      ParchinEnrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdBy       User                @relation("ParchinReportCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([enrollmentId, status, periodEnd])
  @@index([status, publishedAt])
}

model ProviderCatalogAsset {
  id           String                   @id @default(cuid())
  provider     InfrastructureProvider
  apiVersion   String                   @default("v1")
  regionCode   String
  kind         ProviderCatalogAssetKind
  externalId   String
  name         String
  status       ProviderCatalogStatus    @default(ACTIVE)
  available    Boolean                  @default(true)
  isDefault    Boolean                  @default(false)
  lastSeenAt   DateTime
  lastSyncedAt DateTime
  rawUpdatedAt DateTime?
  rawPayload   Json
  payloadHash  String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([provider, apiVersion, regionCode, kind, externalId])
  @@index([provider, apiVersion, regionCode, kind, status])
}

model ProviderCatalogRegionState {
  id                   String                 @id @default(cuid())
  provider             InfrastructureProvider
  apiVersion           String                 @default("v1")
  regionCode           String
  available            Boolean                @default(true)
  status               ProviderCatalogStatus  @default(ACTIVE)
  lastSeenAt           DateTime?
  lastSyncedAt         DateTime?
  lastSuccessfulSyncAt DateTime?
  lastError            String?
  providerRequestId    String?
  syncDurationMs       Int?
  rawPayload           Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([provider, apiVersion, regionCode])
  @@index([provider, apiVersion, status])
}

model ProviderCatalogSyncRun {
  id                String                 @id @default(cuid())
  provider          InfrastructureProvider
  apiVersion        String
  status            ProviderSyncStatus     @default(RUNNING)
  catalogVersion    String
  regionCount       Int                    @default(0)
  successfulRegions Int                    @default(0)
  failedRegions     Int                    @default(0)
  planCount         Int                    @default(0)
  imageCount        Int                    @default(0)
  networkCount      Int                    @default(0)
  securityCount     Int                    @default(0)
  report            Json?
  startedAt         DateTime               @default(now())
  finishedAt        DateTime?
  durationMs        Int?

  @@index([provider, apiVersion, startedAt])
  @@index([status, startedAt])
}

model OperationalIncident {
  id              String                      @id @default(cuid())
  provider        InfrastructureProvider?
  apiVersion      String?
  operation       String
  safeCode        String
  title           String
  safeMessage     String
  severity        OperationalIncidentSeverity
  status          OperationalIncidentStatus   @default(OPEN)
  fingerprint     String
  occurrenceCount Int                         @default(1)
  firstOccurredAt DateTime                    @default(now())
  lastOccurredAt  DateTime                    @default(now())
  resolvedAt      DateTime?
  resolutionCode  String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  deliveries      OperationalAlertOutbox[]

  @@index([status, severity, lastOccurredAt])
  @@index([provider, status, lastOccurredAt])
  @@index([fingerprint, status])
}

model OperationalAlertOutbox {
  id             String                         @id @default(cuid())
  incidentId     String
  recipient      String
  channel        String                         @default("SMS")
  idempotencyKey String                         @unique
  status         OperationalAlertDeliveryStatus @default(PENDING)
  attemptCount   Int                            @default(0)
  nextAttemptAt  DateTime                       @default(now())
  lastErrorCode  String?
  sentAt         DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  incident       OperationalIncident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt])
  @@index([incidentId, createdAt])
}

model AdminAlertSubscription {
  id           String   @id @default(cuid())
  userId       String   @unique
  smsEnabled   Boolean  @default(true)
  criticalOnly Boolean  @default(true)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([active, smsEnabled])
}

model ProductFlowTransition {
  id                      String   @id @default(cuid())
  recommendationSessionId String?
  serviceOrderId          String?
  infrastructureOrderId   String?
  fromState               String
  toState                 String
  reason                  String?
  metadata                Json?
  idempotencyKey          String   @unique
  ownerFingerprint        String
  fromRevision            Int
  toRevision              Int
  actorUserId             String?
  createdAt               DateTime @default(now())

  @@index([recommendationSessionId, createdAt])
  @@index([serviceOrderId, createdAt])
  @@index([infrastructureOrderId, createdAt])
}

model InfrastructureHealthCheck {
  id                       String                          @id @default(cuid())
  infrastructureOrderId    String
  cloudInstanceId          String
  attempt                  Int
  status                   InfrastructureHealthCheckStatus @default(RUNNING)
  providerState            String?
  expectedIpv4             String?
  observedIpv4             String?
  expectedNetworkId        String?
  observedNetworkId        String?
  expectedSecurityId       String?
  observedSecurityId       String?
  topologyVerificationMode String                          @default("STRICT_OBSERVED")
  providerObservedAt       DateTime?
  connectivityProtocol     String?
  resultCode               String?
  durationMs               Int?
  checkedAt                DateTime                        @default(now())
  finishedAt               DateTime?
  metadata                 Json?
  infrastructureOrder      InfrastructureOrder             @relation(fields: [infrastructureOrderId], references: [id], onDelete: Cascade)
  cloudInstance            CloudInstance                   @relation(fields: [cloudInstanceId], references: [id], onDelete: Cascade)

  @@unique([infrastructureOrderId, attempt])
  @@index([infrastructureOrderId, status, checkedAt])
  @@index([cloudInstanceId, checkedAt])
}

model SecureDeliveryEvent {
  id                    String               @id @default(cuid())
  infrastructureOrderId String
  cloudInstanceId       String
  status                SecureDeliveryStatus @default(PENDING)
  method                String
  resultCode            String?
  metadata              Json?
  deliveredAt           DateTime?
  createdAt             DateTime             @default(now())
  infrastructureOrder   InfrastructureOrder  @relation(fields: [infrastructureOrderId], references: [id], onDelete: Cascade)
  cloudInstance         CloudInstance        @relation(fields: [cloudInstanceId], references: [id], onDelete: Cascade)

  @@index([infrastructureOrderId, status, createdAt])
  @@index([cloudInstanceId, createdAt])
}

enum AccountingJournalStatus {
  PENDING
  POSTED
  REVERSED
}

enum AccountingQuality {
  FINAL
  ESTIMATED
  NEEDS_RECONCILIATION
  REVERSED
}

enum OperatingExpenseStatus {
  DRAFT
  POSTED
  REVERSED
}

enum OperatingExpenseCategory {
  GATEWAY_FEES
  SMS_EXPENSE
  SUPPORT_OPERATIONS
  HOSTING_OPERATIONS
  MARKETING_EXPENSE
  PAYROLL_CONTRACTOR
  OTHER_OPERATING_EXPENSE
}

/// Append-only operational accounting journal header.
model AccountingJournalEntry {
  id              String                  @id @default(cuid())
  eventType       String
  referenceType   String
  referenceId     String
  idempotencyKey  String                  @unique
  occurredAt      DateTime
  status          AccountingJournalStatus @default(POSTED)
  quality         AccountingQuality       @default(FINAL)
  metadata        Json?
  postedAt        DateTime                @default(now())
  /// When set, this entry reverses the referenced posted entry.
  reversesEntryId String?                 @unique
  actorUserId     String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  lines           AccountingJournalLine[]
  reversesEntry   AccountingJournalEntry? @relation("JournalReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedByEntry AccountingJournalEntry? @relation("JournalReversal")

  @@index([referenceType, referenceId])
  @@index([eventType, occurredAt])
  @@index([status, occurredAt])
  @@index([quality, occurredAt])
}

model AccountingJournalLine {
  id             String                 @id @default(cuid())
  journalEntryId String
  accountCode    String
  debitRial      BigInt                 @default(0)
  creditRial     BigInt                 @default(0)
  description    String?
  metadata       Json?
  sortOrder      Int                    @default(0)
  createdAt      DateTime               @default(now())
  journalEntry   AccountingJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@index([journalEntryId, sortOrder])
  @@index([accountCode])
}

model OperatingExpense {
  id             String                   @id @default(cuid())
  date           DateTime
  amountRial     BigInt
  category       OperatingExpenseCategory
  title          String
  description    String?
  vendor         String?
  reference      String?
  notes          String?
  status         OperatingExpenseStatus   @default(DRAFT)
  createdById    String
  postedById     String?
  reversedById   String?
  postedAt       DateTime?
  reversedAt     DateTime?
  journalEntryId String?                  @unique
  reversalReason String?
  /**
   * Optional client Idempotency-Key for draft-create retries.
   */
  idempotencyKey String?                  @unique
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  createdBy      User                     @relation("OperatingExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy       User?                    @relation("OperatingExpensePostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  reversedBy     User?                    @relation("OperatingExpenseReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)

  @@index([status, date])
  @@index([category, date])
  @@index([createdById, createdAt])
}

model ProfitCurveConfiguration {
  id                                String            @id @default("default")
  enabled                           Boolean           @default(true)
  minimumPostDiscountGrossMarginBps Int               @default(2000)
  activeRevisionId                  String?
  updatedAt                         DateTime          @updatedAt
  updatedById                       String?
  updatedBy                         User?             @relation("ProfitCurveUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  bands                             ProfitCurveBand[]
}

model ProfitCurveBand {
  id                   String                   @id @default(cuid())
  configurationId      String                   @default("default")
  sortOrder            Int
  minProviderCostRial  BigInt
  maxProviderCostRial  BigInt?
  targetGrossMarginBps Int
  configuration        ProfitCurveConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@unique([configurationId, sortOrder])
  @@index([configurationId, minProviderCostRial])
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportRequestPriority {
  NORMAL
  HIGH
  URGENT
}

enum SupportRequestCategory {
  DELIVERY
  ACCESS
  BILLING
  RENEWAL
  CHANGE
  OTHER
}

enum SupportRequestKind {
  GENERAL
  ROUTINE
  P1_INCIDENT
}

/// Minimal production support requests for purchased Parchin contracts.
model SupportRequest {
  id                   String                  @id @default(cuid())
  userId               String
  cloudInstanceId      String?
  serviceOrderId       String?
  parchinEnrollmentId  String?
  category             SupportRequestCategory
  kind                 SupportRequestKind      @default(GENERAL)
  subject              String
  description          String
  status               SupportRequestStatus    @default(OPEN)
  priority             SupportRequestPriority  @default(NORMAL)
  /// Snapshotted from linked service purchase; customer cannot self-elevate.
  parchinLevel         ParchinLevel?
  assignedToId         String?
  firstResponseDueAt   DateTime?
  firstRespondedAt     DateTime?
  resolvedAt           DateTime?
  routineQuotaConsumed Boolean                 @default(false)
  p1DeclaredAt         DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cloudInstance        CloudInstance?          @relation(fields: [cloudInstanceId], references: [id], onDelete: SetNull)
  serviceOrder         ServiceOrder?           @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  parchinEnrollment    ParchinEnrollment?      @relation(fields: [parchinEnrollmentId], references: [id], onDelete: SetNull)
  assignedTo           User?                   @relation("SupportRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages             SupportRequestMessage[]

  @@index([userId, createdAt])
  @@index([status, priority, createdAt])
  @@index([cloudInstanceId])
  @@index([serviceOrderId])
  @@index([parchinEnrollmentId, kind, createdAt])
  @@index([assignedToId, status, firstResponseDueAt])
  @@index([status, firstResponseDueAt])
}

model SupportRequestMessage {
  id           String         @id @default(cuid())
  requestId    String
  authorUserId String
  body         String
  isStaff      Boolean        @default(false)
  createdAt    DateTime       @default(now())
  request      SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author       User           @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([authorUserId])
}
