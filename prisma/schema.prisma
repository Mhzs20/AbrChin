model User {
  id                          String                              @id @default(cuid())
  mobile                      String                              @unique
  /// Compatibility display field; derived from firstName + lastName for new registrations.
  displayName                 String?
  firstName                   String?
  lastName                    String?
  /// Normalized (trim + lowercase). Unique when set.
  email                       String?                             @unique
  emailVerifiedAt             DateTime?
  /// Null = new customer must complete registration. Existing users backfilled on migrate.
  registrationCompletedAt     DateTime?
  role                        UserRole                            @default(CUSTOMER)
  accountStatus               UserAccountStatus                   @default(ACTIVE)
  blockedAt                   DateTime?
  blockedReason               String?
  mobileVerifiedAt            DateTime?
  createdAt                   DateTime                            @default(now())
  updatedAt                   DateTime                            @updatedAt
  sessions                    Session[]
  emailVerificationChallenges EmailVerificationChallenge[]
  wallet                      Wallet?
  orders                      ServiceOrder[]
  gatewayAudits               PaymentGatewayAuditLog[]            @relation("GatewayAuditActor")
  updatedGateways             PaymentGatewayConfig[]              @relation("GatewayUpdatedBy")
  walletTopUpSettingsUpdated  WalletTopUpSettings[]               @relation("WalletTopUpSettingsUpdatedBy")
  infrastructureOrders        InfrastructureOrder[]
  cloudInstances              CloudInstance[]
  recommendationSessions      RecommendationSession[]
  credentialsCreated          InstanceCredential[]                @relation("CredentialCreatedBy")
  subscriptions               ServiceSubscription[]
  renewalQuotes               ServiceRenewalQuote[]
  fundingConfirmations        ProviderFundingConfirmation[]       @relation("FundingConfirmedBy")
  auditLogs                   AuditLog[]                          @relation("AuditActor")
  adminCommandReceipts        AdminCommandReceipt[]               @relation("AdminCommandActor")
  infrastructurePlansUpdated  InfrastructurePlan[]                @relation("PlanUpdatedBy")
  providerPricingUpdated      ProviderPricingConfig[]             @relation("ProviderPricingUpdatedBy")
  providerRegionsCreated      ProviderRegionConfig[]              @relation("ProviderRegionCreatedBy")
  providerRegionsUpdated      ProviderRegionConfig[]              @relation("ProviderRegionUpdatedBy")
  catalogItemsManuallyUpdated ProviderCatalogItem[]               @relation("CatalogItemManualUpdatedBy")
  storefrontSlotsUpdated      StorefrontAssortmentSlot[]          @relation("StorefrontSlotUpdatedBy")
  storefrontSettingsUpdated   StorefrontAssortmentSettings[]      @relation("StorefrontSettingsUpdatedBy")
  financeRevisions            FinanceConfigurationRevision[]      @relation("FinanceRevisionActor")
  inventoryItemsCreated       PreprovisionedInventoryItem[]       @relation("InventoryCreatedBy")
  inventoryItemsUpdated       PreprovisionedInventoryItem[]       @relation("InventoryUpdatedBy")
  inventoryCredentialsCreated PreprovisionedInventoryCredential[] @relation("InventoryCredentialCreatedBy")
  alertSubscription           AdminAlertSubscription?
  paymentRecoveryActions      PaymentRecoveryAction[]             @relation("PaymentRecoveryActor")
  topUpRefundsRequested       WalletTopUpRefund[]                 @relation("TopUpRefundRequestedBy")
  topUpRefundsReviewed        WalletTopUpRefund[]                 @relation("TopUpRefundReviewedBy")
  billingPoliciesCreated      BillingPolicyVersion[]              @relation("BillingPolicyCreatedBy")
  activationRequests          ActivationRequest[]
  activationApprovals         ActivationRequest[]                 @relation("ActivationApprovedBy")
  resourceChangeRequests      ResourceChangeRequest[]             @relation("ResourceChangeRequestedBy")
  resourceChangeApprovals     ResourceChangeRequest[]             @relation("ResourceChangeApprovedBy")
  couponsForUser              Coupon[]                            @relation("CouponForUser")
  couponsCreated              Coupon[]                            @relation("CouponCreatedBy")
  couponRedemptions           CouponRedemption[]
  billingInvoices             BillingInvoice[]
  outstandingBalances         OutstandingBalance[]
  billingAdjustmentsCreated   BillingAdjustment[]                 @relation("BillingAdjustmentCreatedBy")
  billingAdjustments          BillingAdjustment[]
  operatingExpensesCreated    OperatingExpense[]                  @relation("OperatingExpenseCreatedBy")
  operatingExpensesPosted     OperatingExpense[]                  @relation("OperatingExpensePostedBy")
  operatingExpensesReversed   OperatingExpense[]                  @relation("OperatingExpenseReversedBy")
  profitCurveUpdated          ProfitCurveConfiguration[]          @relation("ProfitCurveUpdatedBy")
  supportRequests             SupportRequest[]
  supportMessages             SupportRequestMessage[]             @relation("SupportMessageAuthor")
  assignedSupportRequests     SupportRequest[]                    @relation("SupportRequestAssignee")
  parchinEnrollments          ParchinEnrollment[]                 @relation("ParchinCustomer")
  assignedParchinTasks        ParchinTask[]                       @relation("ParchinTaskAssignee")
  completedParchinTasks       ParchinTask[]                       @relation("ParchinTaskCompleter")
  createdParchinReports       ParchinReport[]                     @relation("ParchinReportCreator")
}

model OtpChallenge {
  id         String     @id @default(cuid())
  mobile     String
  codeHash   String
  purpose    OtpPurpose @default(LOGIN)
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([mobile, purpose, createdAt])
  @@index([expiresAt])
}

/// Email verification codes — separate from mobile LOGIN OTP challenges.
model EmailVerificationChallenge {
  id         String    @id @default(cuid())
  userId     String
  /// Normalized email the code was issued for (must match User.email on verify).
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, email, createdAt])
  @@index([expiresAt])
}

/// Atomic fixed-window rate-limit state shared across web replicas.
model RateLimitBucket {
  key           String   @id
  count         Int      @default(0)
  windowStartAt DateTime
  expiresAt     DateTime
  updatedAt     DateTime @updatedAt

  @@index([expiresAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  ipAddress String?
  userAgent String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Wallet {
  id                 String              @id @default(cuid())
  userId             String              @unique
  currency           String              @default("IRR")
  availableBalance   BigInt              @default(0)
  status             WalletStatus        @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries      WalletLedgerEntry[]
  topUps             WalletTopUp[]
  billingInvoices    BillingInvoice[]
  billingAdjustments BillingAdjustment[]
}

model WalletLedgerEntry {
  id              String          @id @default(cuid())
  walletId        String
  direction       LedgerDirection
  type            LedgerType
  amount          BigInt
  status          LedgerStatus    @default(PENDING)
  referenceType   String?
  referenceId     String?
  idempotencyKey  String          @unique
  balanceAfter    BigInt
  description     String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  reversedEntryId String?
  wallet          Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@index([status])
  @@index([reversedEntryId])
}

model WalletTopUp {
  id                    String                 @id @default(cuid())
  walletId              String
  amount                BigInt
  gateway               PaymentGatewayProvider
  status                TopUpStatus            @default(CREATED)
  authority             String?                @unique
  gatewayReference      String?                @unique
  gatewayConfigSnapshot Json?
  idempotencyKey        String                 @unique
  callbackTokenHash     String
  failureCode           String?
  failureMessage        String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  verifiedAt            DateTime?
  expiresAt             DateTime
  purchaseOrderId       String?
  requestFingerprint    String?
  redirectUrl           String?
  couponCode            String?
  bonusRialSnapshot     BigInt?
  wallet                Wallet                 @relation(fields: [walletId], references: [id], onDelete: Cascade)
  purchaseOrder         ServiceOrder?          @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  paymentAttempts       PaymentAttempt[]
  recoveryCases         PaymentRecoveryCase[]
  controlledRefunds     WalletTopUpRefund[]

  @@index([walletId, createdAt])
  @@index([status, expiresAt])
  @@index([callbackTokenHash])
  @@index([gateway, status])
  @@index([purchaseOrderId, status])
}

model WalletTopUpSettings {
  id                    String   @id @default("default")
  suggestedAmountsToman Json
  updatedAt             DateTime @updatedAt
  updatedById           String?
  updatedBy             User?    @relation("WalletTopUpSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model PaymentGatewayConfig {
  id            String                    @id @default(cuid())
  provider      PaymentGatewayProvider    @unique
  displayName   String
  enabled       Boolean                   @default(false)
  isDefault     Boolean                   @default(false)
  priority      Int
  environment   PaymentGatewayEnvironment
  minAmountRial BigInt?
  maxAmountRial BigInt?
  description   String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  updatedById   String?
  updatedBy     User?                     @relation("GatewayUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  auditLogs     PaymentGatewayAuditLog[]

  @@index([enabled, isDefault])
  @@index([priority])
}

model PaymentGatewayAuditLog {
  id              String               @id @default(cuid())
  gatewayConfigId String
  actorUserId     String
  action          String
  beforeData      Json?
  afterData       Json?
  ip              String?
  userAgent       String?
  createdAt       DateTime             @default(now())
  gatewayConfig   PaymentGatewayConfig @relation(fields: [gatewayConfigId], references: [id], onDelete: Cascade)
  actor           User                 @relation("GatewayAuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([gatewayConfigId, createdAt])
  @@index([actorUserId, createdAt])
}

model ServiceOrder {
  id                          String                        @id @default(cuid())
  userId                      String
  title                       String
  description                 String?
  amount                      BigInt
  termMonths                  Int                           @default(1)
  termDiscountBps             Int                           @default(0)
  couponCodeSnapshot          String?
  currency                    String                        @default("IRR")
  status                      ServiceOrderStatus            @default(DRAFT)
  planCode                    String?
  planId                      String?
  planSnapshot                Json?
  recommendationQuoteId       String?                       @unique
  quoteExpiresAt              DateTime?
  provider                    InfrastructureProvider?
  providerApiVersion          String?
  productKind                 InfrastructureProductKind?
  parchinLevel                ParchinLevel?
  /// Immutable Parchin service-contract snapshot copied from the locked Quote.
  parchinServiceSnapshot      Json?
  /// Immutable commercial economics / profit-curve audit snapshot at purchase.
  commercialEconomicsSnapshot Json?
  productFlowState            String?
  productFlowRevision         Int                           @default(0)
  paidAt                      DateTime?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  user                        User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                        InfrastructurePlan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  recommendationQuote         RecommendationQuote?          @relation(fields: [recommendationQuoteId], references: [id], onDelete: SetNull)
  infrastructureOrder         InfrastructureOrder?
  subscription                ServiceSubscription?
  adminCommandReceipts        AdminCommandReceipt[]
  reservedInventoryItems      PreprovisionedInventoryItem[] @relation("InventoryReservedOrder")
  assignedInventoryItems      PreprovisionedInventoryItem[] @relation("InventoryAssignedOrder")
  purchaseTopUps              WalletTopUp[]
  supportRequests             SupportRequest[]
  orderPayment                OrderPayment?
  activationRequest           ActivationRequest?
  parchinEnrollment           ParchinEnrollment?

  @@index([userId, createdAt])
  @@index([status])
  @@index([planId])
}

model OrderPayment {
  id                    String                 @id @default(cuid())
  serviceOrderId        String                 @unique
  amount                BigInt
  gateway               PaymentGatewayProvider
  status                OrderPaymentStatus     @default(CREATED)
  authority             String?                @unique
  gatewayReference      String?                @unique
  gatewayConfigSnapshot Json?
  idempotencyKey        String                 @unique
  callbackTokenHash     String
  failureCode           String?
  failureMessage        String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  verifiedAt            DateTime?
  expiresAt             DateTime
  redirectUrl           String?
  serviceOrder          ServiceOrder           @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([callbackTokenHash])
  @@index([gateway, status])
}

model PaymentAttempt {
  id                    String                  @id @default(cuid())
  walletTopUpId         String
  attemptNumber         Int
  amount                BigInt
  currency              String                  @default("IRR")
  gateway               PaymentGatewayProvider
  status                PaymentAttemptStatus    @default(CREATED)
  authority             String?                 @unique
  gatewayReference      String?                 @unique
  gatewayConfigSnapshot Json?
  callbackTokenHash     String
  expiresAt             DateTime                @db.Timestamptz(3)
  verifiedAt            DateTime?               @db.Timestamptz(3)
  nextReconcileAt       DateTime?               @db.Timestamptz(3)
  verificationAttempts  Int                     @default(0)
  failureCode           String?
  failureMessage        String?
  idempotencyKey        String                  @unique
  redirectUrl           String?
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  walletTopUp           WalletTopUp             @relation(fields: [walletTopUpId], references: [id], onDelete: Cascade)
  recoveryCase          PaymentRecoveryCase?
  recoveryActions       PaymentRecoveryAction[]

  @@unique([walletTopUpId, attemptNumber])
  @@index([walletTopUpId, createdAt])
  @@index([status, nextReconcileAt])
  @@index([gateway, status])
}

model PaymentRecoveryCase {
  id               String                  @id @default(cuid())
  walletTopUpId    String
  attemptId        String                  @unique
  status           PaymentReviewStatus     @default(OPEN)
  reasonCode       String
  safeMessage      String
  expectedAmount   BigInt
  observedAmount   BigInt?
  expectedCurrency String                  @default("IRR")
  observedCurrency String?
  nextAttemptAt    DateTime?               @db.Timestamptz(3)
  attemptCount     Int                     @default(0)
  resolvedAt       DateTime?               @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)
