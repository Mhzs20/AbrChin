model ProviderCatalogItem {
  id                           String                        @id @default(cuid())
  provider                     InfrastructureProvider
  apiVersion                   String                        @default("v1")
  productKind                  InfrastructureProductKind     @default(READY_INSTANT_SERVER)
  source                       ProviderCatalogItemSource     @default(API_CATALOG)
  regionCode                   String
  sizeCode                     String
  externalPlanId               String?
  externalKey                  String?                       @unique
  sizeName                     String
  compatibleImageCodes         Json
  vcpu                         Int?
  ramMb                        Int?
  diskGb                       Int?
  transfer                     String?
  available                    Boolean                       @default(false)
  active                       Boolean                       @default(true)
  status                       ProviderCatalogStatus         @default(ACTIVE)
  priceHourlyAmount            BigInt?
  priceMonthlyAmount           BigInt?
  priceScale                   Int                           @default(6)
  currencyCode                 String?
  amountUnit                   String?
  providerHourlyPriceIrr       BigInt?
  providerMonthlyPriceIrr      BigInt?
  lastSyncedAt                 DateTime
  lastSeenAt                   DateTime?
  rawUpdatedAt                 DateTime?
  rawPayload                   Json?
  payloadHash                  String?
  catalogVersion               String?
  unavailableAt                DateTime?
  manualAvailableUnits         Int?
  manualPriceValidUntil        DateTime?
  manualLastVerifiedAt         DateTime?
  manualUpdatedById            String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  plans                        InfrastructurePlan[]
  recommendationQuotes         RecommendationQuote[]
  renewalQuotes                ServiceRenewalQuote[]
  manualUpdatedBy              User?                         @relation("CatalogItemManualUpdatedBy", fields: [manualUpdatedById], references: [id], onDelete: SetNull)
  preprovisionedInventoryItems PreprovisionedInventoryItem[]

  @@unique([provider, apiVersion, regionCode, externalPlanId])
  @@index([provider, available, active])
  @@index([provider, apiVersion, productKind, status])
  @@index([provider, apiVersion, source, status])
  @@index([provider, lastSyncedAt])
  @@index([manualUpdatedById])
}

model PreprovisionedInventoryItem {
  id                   String                             @id @default(cuid())
  catalogItemId        String
  planId               String
  provider             InfrastructureProvider
  apiVersion           String                             @default("v1")
  providerResourceId   String
  regionCode           String
  externalPlanId       String
  externalImageId      String
  observedState        String
  observedIpv4         String?
  observedNetworkId    String?
  observedSecurityId   String?
  lastObservedAt       DateTime
  lastHealthCheckedAt  DateTime?
  healthStatus         PreprovisionedHealthStatus         @default(UNKNOWN)
  inventoryStatus      PreprovisionedInventoryStatus      @default(STALE)
  reservedByQuoteId    String?                            @unique
  reservedByOrderId    String?                            @unique
  reservedRevision     Int?
  reservedAt           DateTime?
  reservationExpiresAt DateTime?
  assignedOrderId      String?                            @unique
  assignedAt           DateTime?
  deliveredAt          DateTime?
  disabledAt           DateTime?
  adminAudit           Json?
  createdById          String?
  updatedById          String?
  createdAt            DateTime                           @default(now())
  updatedAt            DateTime                           @updatedAt
  catalogItem          ProviderCatalogItem                @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  plan                 InfrastructurePlan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  reservedByQuote      RecommendationQuote?               @relation("InventoryReservedQuote", fields: [reservedByQuoteId], references: [id], onDelete: SetNull)
  reservedByOrder      ServiceOrder?                      @relation("InventoryReservedOrder", fields: [reservedByOrderId], references: [id], onDelete: SetNull)
  assignedOrder        ServiceOrder?                      @relation("InventoryAssignedOrder", fields: [assignedOrderId], references: [id], onDelete: Restrict)
  infrastructureOrder  InfrastructureOrder?
  quotedBy             RecommendationQuote[]              @relation("QuoteInventorySnapshot")
  createdBy            User?                              @relation("InventoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?                              @relation("InventoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  credential           PreprovisionedInventoryCredential?

  @@unique([provider, apiVersion, providerResourceId])
  @@index([planId, inventoryStatus, healthStatus])
  @@index([catalogItemId, inventoryStatus])
  @@index([reservationExpiresAt])
  @@index([assignedOrderId])
}

model PreprovisionedInventoryCredential {
  id                String                                  @id @default(cuid())
  inventoryItemId   String                                  @unique
  username          String
  ciphertext        String
  iv                String
  authTag           String
  secretFingerprint String                                  @unique
