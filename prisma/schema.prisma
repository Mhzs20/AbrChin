generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OtpPurpose {
  LOGIN
}

enum WalletStatus {
  ACTIVE
  FROZEN
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerType {
  TOP_UP
  SERVICE_PURCHASE
  SERVICE_RENEWAL
  REFUND
  ADMIN_ADJUSTMENT
}

enum LedgerStatus {
  PENDING
  COMPLETED
  REVERSED
  FAILED
}

enum TopUpStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  EXPIRED
}

enum ServiceOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELED
  REFUNDED
}

enum RecommendationFlowStatus {
  DISCOVERY
  PROFILING
  READY_TO_COMPARE
  COMPARING
  QUOTED
  CHECKOUT
  CONVERTED
  EXPIRED
  ESCALATED
}

enum RecommendationQuoteRole {
  ECONOMY
  RECOMMENDED
  GROWTH
}

enum RecommendationQuoteStatus {
  ACTIVE
  SELECTED
  CONVERTED
  EXPIRED
  INVALIDATED
}

enum CatalogMappingStatus {
  UNMAPPED
  MAPPED
}

enum RenewalQuoteStatus {
  ACTIVE
  PAID
  EXPIRED
  INVALIDATED
}

enum InfrastructureProvider {
  PARSPACK
  ARVAN
}

enum InfrastructureProductKind {
  READY_INSTANT_SERVER
  CLOUD_SERVER
}

enum ProviderCatalogStatus {
  ACTIVE
  STALE
  UNAVAILABLE
  INVALID_RESOURCE
  INVALID_PRICE
  DISABLED
}

enum ProviderCatalogAssetKind {
  IMAGE
  NETWORK
  SECURITY
}

enum ProviderSyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum ParchinLevel {
  PARCHIN_START
  PARCHIN_ACTIVE
  PARCHIN_STABLE
}

enum QuoteLineItemType {
  PROVIDER_INFRASTRUCTURE
  INFRASTRUCTURE_MARKUP
  PARCHIN
  PROVIDER_ADDON
  TAX
}

enum DeliveryMode {
  RAW
  MANAGED
}

enum InfrastructureOrderStatus {
  WAITING_ADMIN_FUNDING
  FUNDING_CONFIRMED
  QUEUED
  PROVISIONING
  ACTIVE
  BLOCKED_PROVIDER_BALANCE
  NEEDS_RECONCILIATION
  MANUAL_REVIEW
  FAILED
  CANCELED
  REFUNDED
}

enum ProvisioningJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED_PROVIDER_BALANCE
  NEEDS_RECONCILIATION
}

enum AdminNotificationType {
  ORDER_WAITING_PROVIDER_FUNDING
  PROVIDER_BALANCE_BLOCKED
  PROVISIONING_FAILED
  NEEDS_RECONCILIATION
  INSTANCE_ACTIVE
  PAYMENT_FAILED
  PROVIDER_UNAVAILABLE
  RENEWAL_PAID
  RENEWAL_DUE
}

enum AdminNotificationStatus {
  UNREAD
  READ
  RESOLVED
}

enum CloudInstanceStatus {
  PENDING
  ACTIVE
  FAILED
  TERMINATED
}

enum InstanceCredentialStatus {
  READY
  REVEALED
  REVOKED
  EXPIRED
}

enum InfrastructureHealthCheckStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum SecureDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  TERMINATED
}

enum PaymentGatewayProvider {
  ZIBAL
  ZARINPAL
  MOCK
}

enum PaymentGatewayEnvironment {
  DEVELOPMENT
  SANDBOX
  PRODUCTION
}

model User {
  id                         String                        @id @default(cuid())
  mobile                     String                        @unique
  displayName                String?
  role                       UserRole                      @default(CUSTOMER)
  mobileVerifiedAt           DateTime?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  sessions                   Session[]
  wallet                     Wallet?
  orders                     ServiceOrder[]
  gatewayAudits              PaymentGatewayAuditLog[]      @relation("GatewayAuditActor")
  updatedGateways            PaymentGatewayConfig[]        @relation("GatewayUpdatedBy")
  walletTopUpSettingsUpdated WalletTopUpSettings[]         @relation("WalletTopUpSettingsUpdatedBy")
  infrastructureOrders       InfrastructureOrder[]
  cloudInstances             CloudInstance[]
  recommendationSessions     RecommendationSession[]
  credentialsCreated         InstanceCredential[]          @relation("CredentialCreatedBy")
  subscriptions              ServiceSubscription[]
  renewalQuotes              ServiceRenewalQuote[]
  fundingConfirmations       ProviderFundingConfirmation[] @relation("FundingConfirmedBy")
  auditLogs                  AuditLog[]                    @relation("AuditActor")
  infrastructurePlansUpdated InfrastructurePlan[]          @relation("PlanUpdatedBy")
  providerPricingUpdated     ProviderPricingConfig[]       @relation("ProviderPricingUpdatedBy")
}

model OtpChallenge {
  id         String     @id @default(cuid())
  mobile     String
  codeHash   String
  purpose    OtpPurpose @default(LOGIN)
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([mobile, purpose, createdAt])
  @@index([expiresAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  ipAddress String?
  userAgent String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Wallet {
  id               String              @id @default(cuid())
  userId           String              @unique
  currency         String              @default("IRR")
  availableBalance BigInt              @default(0)
  status           WalletStatus        @default(ACTIVE)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries    WalletLedgerEntry[]
  topUps           WalletTopUp[]
}

model WalletLedgerEntry {
  id              String          @id @default(cuid())
  walletId        String
  direction       LedgerDirection
  type            LedgerType
  amount          BigInt
  status          LedgerStatus    @default(PENDING)
  referenceType   String?
  referenceId     String?
  idempotencyKey  String          @unique
  balanceAfter    BigInt
  description     String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  reversedEntryId String?
  wallet          Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@index([status])
  @@index([reversedEntryId])
}

model WalletTopUp {
  id                    String                 @id @default(cuid())
  walletId              String
  amount                BigInt
  gateway               PaymentGatewayProvider
  status                TopUpStatus            @default(CREATED)
  authority             String?                @unique
  gatewayReference      String?                @unique
  gatewayConfigSnapshot Json?
  idempotencyKey        String                 @unique
  callbackTokenHash     String
  failureCode           String?
  failureMessage        String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  verifiedAt            DateTime?
  expiresAt             DateTime
  wallet                Wallet                 @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([status, expiresAt])
  @@index([callbackTokenHash])
  @@index([gateway, status])
}

model WalletTopUpSettings {
  id                    String   @id @default("default")
  suggestedAmountsToman Json
  updatedAt             DateTime @updatedAt
  updatedById           String?
  updatedBy             User?    @relation("WalletTopUpSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model PaymentGatewayConfig {
  id            String                    @id @default(cuid())
  provider      PaymentGatewayProvider    @unique
  displayName   String
  enabled       Boolean                   @default(false)
  isDefault     Boolean                   @default(false)
  priority      Int
  environment   PaymentGatewayEnvironment
  minAmountRial BigInt?
  maxAmountRial BigInt?
  description   String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  updatedById   String?
  updatedBy     User?                     @relation("GatewayUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  auditLogs     PaymentGatewayAuditLog[]

  @@index([enabled, isDefault])
  @@index([priority])
}

model PaymentGatewayAuditLog {
  id              String               @id @default(cuid())
  gatewayConfigId String
  actorUserId     String
  action          String
  beforeData      Json?
  afterData       Json?
  ip              String?
  userAgent       String?
  createdAt       DateTime             @default(now())
  gatewayConfig   PaymentGatewayConfig @relation(fields: [gatewayConfigId], references: [id], onDelete: Cascade)
  actor           User                 @relation("GatewayAuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([gatewayConfigId, createdAt])
  @@index([actorUserId, createdAt])
}

model ServiceOrder {
  id                    String                     @id @default(cuid())
  userId                String
  title                 String
  description           String?
  amount                BigInt
  currency              String                     @default("IRR")
  status                ServiceOrderStatus         @default(DRAFT)
  planCode              String?
  planId                String?
  planSnapshot          Json?
  recommendationQuoteId String?                    @unique
  quoteExpiresAt        DateTime?
  provider              InfrastructureProvider?
  providerApiVersion    String?
  productKind           InfrastructureProductKind?
  parchinLevel          ParchinLevel?
  productFlowState      String?
  productFlowRevision   Int                        @default(0)
  paidAt                DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  InfrastructurePlan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  recommendationQuote   RecommendationQuote?       @relation(fields: [recommendationQuoteId], references: [id], onDelete: SetNull)
  infrastructureOrder   InfrastructureOrder?
  subscription          ServiceSubscription?

  @@index([userId, createdAt])
  @@index([status])
  @@index([planId])
}

model RecommendationSession {
  id                            String                   @id @default(cuid())
  userId                        String?
  guestAccessTokenHash          String?
  claimedAt                     DateTime?
  status                        RecommendationFlowStatus @default(DISCOVERY)
  answers                       Json
  answerSources                 Json
  understandingSnapshot         Json?
  requirementsSummary           Json?
  revision                      Int                      @default(0)
  profile                       Json?
  confidence                    String?
  architectureEscalation        Boolean                  @default(false)
  productFlowState              String?
  productFlowRevision           Int                      @default(0)
  selectedParchinLevel          ParchinLevel?
  deliveryConfiguration         Json?
  catalogCheckoutIdempotencyKey String?                  @unique
  catalogCheckoutRequestHash    String?
  expiresAt                     DateTime
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  user                          User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  quotes                        RecommendationQuote[]

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([guestAccessTokenHash])
}

model RecommendationQuote {
  id                            String                     @id @default(cuid())
  sessionId                     String
  planId                        String
  role                          RecommendationQuoteRole
  status                        RecommendationQuoteStatus  @default(ACTIVE)
  score                         Float
  scoreBreakdown                Json
  reasons                       Json
  profileSnapshot               Json
  planSnapshot                  Json
  amountRial                    BigInt
  renewalAmountRial             BigInt
  catalogItemId                 String?
  providerBasePriceRialSnapshot BigInt?
  markupBasisPointsSnapshot     Int?
  finalPriceRialSnapshot        BigInt?
  currencySnapshot              String?
  providerPriceCheckedAt        DateTime?
  provider                      InfrastructureProvider?
  providerApiVersion            String?
  productKind                   InfrastructureProductKind?
  providerRegion                String?
  externalPlanId                String?
  externalImageId               String?
  externalNetworkId             String?
  externalSecurityId            String?
  vcpuSnapshot                  Int?
  ramMbSnapshot                 Int?
  diskGbSnapshot                Int?
  operatingSystemSnapshot       String?
  providerHourlyPriceIrr        BigInt?
  providerMonthlyPriceIrr       BigInt?
  markupAmountIrr               BigInt?
  parchinLevel                  ParchinLevel?
  parchinPriceIrr               BigInt?
  providerAddonsSnapshot        Json?
  deliveryConfigurationSnapshot Json?
  taxBasisPointsSnapshot        Int?
  taxAmountIrr                  BigInt?
  lineItemsSnapshot             Json?
  quotedAt                      DateTime?
  catalogVersion                String?
  providerPayloadHash           String?
  expiresAt                     DateTime
  selectedAt                    DateTime?
  convertedAt                   DateTime?
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt
  session                       RecommendationSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  plan                          InfrastructurePlan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  catalogItem                   ProviderCatalogItem?       @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  serviceOrder                  ServiceOrder?

  @@index([sessionId, role])
  @@index([sessionId, status])
  @@index([planId, expiresAt])
  @@index([catalogItemId, expiresAt])
  @@index([status, expiresAt])
}

model InfrastructurePlan {
  id                        String                    @id @default(cuid())
  code                      String                    @unique
  title                     String
  description               String?
  provider                  InfrastructureProvider
  providerApiVersion        String                    @default("v1")
  productKind               InfrastructureProductKind @default(READY_INSTANT_SERVER)
  regionCode                String
  sizeCode                  String
  imageCode                 String
  deliveryMode              DeliveryMode
  vcpu                      Int?
  ramGb                     Int?
  storageGb                 Int?
  salePriceRial             BigInt
  renewalPriceRial          BigInt?
  estimatedProviderCostRial BigInt
  deliveryEstimateMinutes   Int                       @default(15)
  parchinIncluded           Boolean                   @default(false)
  minimumParchinLevel       ParchinLevel?
  active                    Boolean                   @default(true)
  sortOrder                 Int                       @default(0)
  catalogItemId             String?
  catalogMappingStatus      CatalogMappingStatus      @default(UNMAPPED)
  catalogMappedAt           DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  updatedById               String?
  updatedBy                 User?                     @relation("PlanUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  catalogItem               ProviderCatalogItem?      @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  orders                    ServiceOrder[]
  recommendationQuotes      RecommendationQuote[]
  infrastructureOrders      InfrastructureOrder[]
  subscriptions             ServiceSubscription[]

  @@index([active, sortOrder])
  @@index([provider, active])
  @@index([catalogItemId])
  @@index([catalogMappingStatus, active])
}

model InfrastructureOrder {
  id                             String                        @id @default(cuid())
  serviceOrderId                 String                        @unique
  userId                         String
  planId                         String
  provider                       InfrastructureProvider
  providerApiVersion             String                        @default("v1")
  productKind                    InfrastructureProductKind     @default(READY_INSTANT_SERVER)
  parchinLevel                   ParchinLevel?
  providerSelectionSnapshot      Json?
  productFlowState               String?
  productFlowRevision            Int                           @default(0)
  deliveryMode                   DeliveryMode
  status                         InfrastructureOrderStatus     @default(WAITING_ADMIN_FUNDING)
  requiredFundingRial            BigInt
  desiredInstanceName            String?                       @unique
  reconcileNoResourceConfirmedAt DateTime?
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt
  serviceOrder                   ServiceOrder                  @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  user                           User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                           InfrastructurePlan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  fundingConfirmations           ProviderFundingConfirmation[]
  provisioningJobs               ProvisioningJob[]
  cloudInstance                  CloudInstance?
  notifications                  AdminNotification[]
  operationLogs                  ProviderOperationLog[]
  healthChecks                   InfrastructureHealthCheck[]
  secureDeliveryEvents           SecureDeliveryEvent[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([planId])
}

model ProviderFundingConfirmation {
  id                    String                 @id @default(cuid())
  infrastructureOrderId String
  attempt               Int
  provider              InfrastructureProvider
  requiredAmountRial    BigInt
  fundedAmountRial      BigInt
  receiptReference      String?
  note                  String?
  confirmedById         String
  confirmedAt           DateTime               @default(now())
  ip                    String?
  userAgent             String?
  idempotencyKey        String                 @unique
  infrastructureOrder   InfrastructureOrder    @relation(fields: [infrastructureOrderId], references: [id], onDelete: Cascade)
  confirmedBy           User                   @relation("FundingConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)

  @@unique([infrastructureOrderId, attempt])
  @@index([confirmedById, confirmedAt])
  @@index([infrastructureOrderId, confirmedAt])
}

model ProvisioningJob {
  id                    String                 @id @default(cuid())
  infrastructureOrderId String
  operation             String
  status                ProvisioningJobStatus  @default(QUEUED)
  idempotencyKey        String                 @unique
  attempt               Int                    @default(1)
  runCount              Int                    @default(0)
  claimCount            Int                    @default(0)
  workerId              String?
  lockedAt              DateTime?
  leaseExpiresAt        DateTime?
  availableAt           DateTime               @default(now())
  jobMetadata           Json?
  createSentAt          DateTime?
  providerRequestId     String?
  providerTaskId        String?
  providerActionId      String?
  reconciliationKey     String?
  providerResourceId    String?
  lastPolledAt          DateTime?
  lastErrorCode         String?
  lastErrorMessage      String?
  startedAt             DateTime?
  finishedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  infrastructureOrder   InfrastructureOrder    @relation(fields: [infrastructureOrderId], references: [id], onDelete: Cascade)
  operationLogs         ProviderOperationLog[]

  @@index([infrastructureOrderId, createdAt])
  @@index([status, createdAt])
  @@index([infrastructureOrderId, operation, status])
  @@index([status, availableAt, createdAt])
}

model CloudInstance {
  id                    String                      @id @default(cuid())
  infrastructureOrderId String                      @unique
  userId                String
  provider              InfrastructureProvider
  providerApiVersion    String                      @default("v1")
  providerInstanceId    String                      @unique
  name                  String
  region                String
  size                  String
  image                 String
  deliveryMode          DeliveryMode
  ipv4                  String?
  providerState         String?
  networkId             String?
  securityId            String?
  providerObservedAt    DateTime?
  status                CloudInstanceStatus         @default(PENDING)
  provisionedAt         DateTime?
  healthCheckedAt       DateTime?
  deliveredAt           DateTime?
  terminatedAt          DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  infrastructureOrder   InfrastructureOrder         @relation(fields: [infrastructureOrderId], references: [id], onDelete: Cascade)
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential            InstanceCredential?
  subscription          ServiceSubscription?
  healthChecks          InfrastructureHealthCheck[]
  secureDeliveryEvents  SecureDeliveryEvent[]

  @@index([userId, createdAt])
  @@index([status])
}

model ServiceSubscription {
  id                 String                @id @default(cuid())
  cloudInstanceId    String                @unique
  sourceOrderId      String                @unique
  userId             String
  planId             String
  status             SubscriptionStatus    @default(ACTIVE)
  parchinLevel       ParchinLevel?
  renewalPriceRial   BigInt
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  nextRenewalAt      DateTime
  graceEndsAt        DateTime
  autoRenew          Boolean               @default(false)
  canceledAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  cloudInstance      CloudInstance         @relation(fields: [cloudInstanceId], references: [id], onDelete: Cascade)
  sourceOrder        ServiceOrder          @relation(fields: [sourceOrderId], references: [id], onDelete: Restrict)
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               InfrastructurePlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  renewalQuotes      ServiceRenewalQuote[]

  @@index([userId, status, nextRenewalAt])
  @@index([status, nextRenewalAt])
}

model ServiceRenewalQuote {
  id                            String                     @id @default(cuid())
  subscriptionId                String
  userId                        String
  catalogItemId                 String
  status                        RenewalQuoteStatus         @default(ACTIVE)
  providerBasePriceRialSnapshot BigInt
  markupBasisPointsSnapshot     Int
  finalPriceRialSnapshot        BigInt
  currency                      String                     @default("IRR")
  providerPriceCheckedAt        DateTime
  provider                      InfrastructureProvider?
  providerApiVersion            String?
  productKind                   InfrastructureProductKind?
  parchinLevel                  ParchinLevel?
  parchinPriceIrrSnapshot       BigInt?
  taxBasisPointsSnapshot        Int?
  taxAmountIrrSnapshot          BigInt?
  lineItemsSnapshot             Json?
  periodStartSnapshot           DateTime
  periodEndSnapshot             DateTime
  expiresAt                     DateTime
  paidAt                        DateTime?
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt
  subscription                  ServiceSubscription        @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  user                          User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  catalogItem                   ProviderCatalogItem        @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, status, expiresAt])
  @@index([userId, createdAt])
  @@index([catalogItemId, createdAt])
}

model InstanceCredential {
  id              String                   @id @default(cuid())
  cloudInstanceId String                   @unique
  createdById     String
  username        String
  ciphertext      String?
  iv              String?
  authTag         String?
  status          InstanceCredentialStatus @default(READY)
  expiresAt       DateTime
  revealedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  cloudInstance   CloudInstance            @relation(fields: [cloudInstanceId], references: [id], onDelete: Cascade)
  createdBy       User                     @relation("CredentialCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([createdById, createdAt])
}

model AdminNotification {
  id                    String                  @id @default(cuid())
  type                  AdminNotificationType
  infrastructureOrderId String?
  title                 String
  message               String
  status                AdminNotificationStatus @default(UNREAD)
  createdAt             DateTime                @default(now())
  resolvedAt            DateTime?
  infrastructureOrder   InfrastructureOrder?    @relation(fields: [infrastructureOrderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([infrastructureOrderId])
}

model ProviderOperationLog {
  id                    String                 @id @default(cuid())
  provider              InfrastructureProvider
  providerApiVersion    String                 @default("v1")
  providerRegion        String?
  endpoint              String?
  httpStatus            Int?
  providerRequestId     String?
  durationMs            Int?
  operation             String
  infrastructureOrderId String?
  provisioningJobId     String?
  status                String
  requestSummary        Json?
  responseSummary       Json?
  errorCode             String?
  createdAt             DateTime               @default(now())
  infrastructureOrder   InfrastructureOrder?   @relation(fields: [infrastructureOrderId], references: [id], onDelete: SetNull)
  provisioningJob       ProvisioningJob?       @relation(fields: [provisioningJobId], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
  @@index([infrastructureOrderId, createdAt])
  @@index([provisioningJobId])
}

model WorkerHeartbeat {
  id          String    @id @default("provisioning")
  workerId    String
  lastSeenAt  DateTime
  lastCycleAt DateTime?
  cyclesTotal Int       @default(0)
  status      String    @default("down")
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String
  action         String
  entityType     String
  entityId       String?
  beforeData     Json?
  afterData      Json?
  ip             String?
  userAgent      String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())
  actor          User     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model ProviderCatalogState {
  id                    String                 @id @default("parspack")
  provider              InfrastructureProvider @unique
  apiVersion            String                 @default("v1")
  enabled               Boolean                @default(true)
  lastHealthCheck       DateTime?
  lastCatalogSync       DateTime?
  regionCount           Int                    @default(0)
  sizeCount             Int                    @default(0)
  imageCount            Int                    @default(0)
  catalogItemCount      Int                    @default(0)
  pricedItemCount       Int                    @default(0)
  unavailableItemCount  Int                    @default(0)
  staleItemCount        Int                    @default(0)
  invalidPriceCount     Int                    @default(0)
  invalidResourceCount  Int                    @default(0)
  networkCount          Int                    @default(0)
  securityCount         Int                    @default(0)
  lastSyncDurationMs    Int?
  lastSyncStatus        ProviderSyncStatus?
  catalogVersion        String?
  freshnessSlaSeconds   Int                    @default(900)
  syncRequestedAt       DateTime?
  syncLeaseToken        String?
  syncLeaseExpiresAt    DateTime?
  regionErrors          Json?
  lastProviderRequestId String?
  lastError             String?
  updatedAt             DateTime               @updatedAt
}

model ProviderCatalogItem {
  id                      String                    @id @default(cuid())
  provider                InfrastructureProvider
  apiVersion              String                    @default("v1")
  productKind             InfrastructureProductKind @default(READY_INSTANT_SERVER)
  regionCode              String
  sizeCode                String
  externalPlanId          String?
  externalKey             String?                   @unique
  sizeName                String
  compatibleImageCodes    Json
  vcpu                    Int?
  ramMb                   Int?
  diskGb                  Int?
  transfer                String?
  available               Boolean                   @default(false)
  active                  Boolean                   @default(true)
  status                  ProviderCatalogStatus     @default(ACTIVE)
  priceHourlyAmount       BigInt?
  priceMonthlyAmount      BigInt?
  priceScale              Int                       @default(6)
  currencyCode            String?
  amountUnit              String?
  providerHourlyPriceIrr  BigInt?
  providerMonthlyPriceIrr BigInt?
  lastSyncedAt            DateTime
  lastSeenAt              DateTime?
  rawUpdatedAt            DateTime?
  rawPayload              Json?
  payloadHash             String?
  catalogVersion          String?
  unavailableAt           DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  plans                   InfrastructurePlan[]
  recommendationQuotes    RecommendationQuote[]
  renewalQuotes           ServiceRenewalQuote[]

  @@unique([provider, apiVersion, regionCode, externalPlanId])
  @@index([provider, available, active])
  @@index([provider, apiVersion, productKind, status])
  @@index([provider, lastSyncedAt])
}

model ProviderPricingConfig {
  id                String                 @id @default("parspack")
  provider          InfrastructureProvider @unique
  apiVersion        String                 @default("v1")
  enabled           Boolean                @default(true)
  sourceMoneyUnit   String?
  markupBasisPoints Int                    @default(0)
  updatedAt         DateTime               @updatedAt
  updatedById       String?
  updatedBy         User?                  @relation("ProviderPricingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model ProductPricingConfig {
  id                String                    @id @default(cuid())
  provider          InfrastructureProvider
  apiVersion        String                    @default("v1")
  productKind       InfrastructureProductKind
  markupBasisPoints Int                       @default(0)
  enabled           Boolean                   @default(true)
  updatedById       String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([provider, apiVersion, productKind])
  @@index([productKind, enabled])
}

model CommercePricingConfig {
  id          String   @id @default("default")
  taxBps      Int      @default(1000)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model ParchinPricingConfig {
  id          String       @id @default(cuid())
  level       ParchinLevel @unique
  title       String
  description String?
  priceRial   BigInt
  active      Boolean      @default(true)
  sortOrder   Int          @default(0)
  updatedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ProviderCatalogAsset {
  id           String                   @id @default(cuid())
  provider     InfrastructureProvider
  apiVersion   String                   @default("v1")
  regionCode   String
  kind         ProviderCatalogAssetKind
  externalId   String
  name         String
  status       ProviderCatalogStatus    @default(ACTIVE)
  available    Boolean                  @default(true)
  isDefault    Boolean                  @default(false)
  lastSeenAt   DateTime
  lastSyncedAt DateTime
  rawUpdatedAt DateTime?
  rawPayload   Json
  payloadHash  String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([provider, apiVersion, regionCode, kind, externalId])
  @@index([provider, apiVersion, regionCode, kind, status])
}

model ProviderCatalogRegionState {
  id                   String                 @id @default(cuid())
  provider             InfrastructureProvider
  apiVersion           String                 @default("v1")
  regionCode           String
  available            Boolean                @default(true)
  status               ProviderCatalogStatus  @default(ACTIVE)
  lastSeenAt           DateTime?
  lastSyncedAt         DateTime?
  lastSuccessfulSyncAt DateTime?
  lastError            String?
  providerRequestId    String?
  syncDurationMs       Int?
  rawPayload           Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([provider, apiVersion, regionCode])
  @@index([provider, apiVersion, status])
}

model ProviderCatalogSyncRun {
  id                String                 @id @default(cuid())
  provider          InfrastructureProvider
  apiVersion        String
  status            ProviderSyncStatus     @default(RUNNING)
  catalogVersion    String
  regionCount       Int                    @default(0)
  successfulRegions Int                    @default(0)
  failedRegions     Int                    @default(0)
  planCount         Int                    @default(0)
  imageCount        Int                    @default(0)
  networkCount      Int                    @default(0)
  securityCount     Int                    @default(0)
  report            Json?
  startedAt         DateTime               @default(now())
  finishedAt        DateTime?
  durationMs        Int?

  @@index([provider, apiVersion, startedAt])
  @@index([status, startedAt])
}

model ProductFlowTransition {
  id                      String   @id @default(cuid())
  recommendationSessionId String?
  serviceOrderId          String?
  infrastructureOrderId   String?
  fromState               String
  toState                 String
  reason                  String?
  metadata                Json?
  idempotencyKey          String   @unique
  ownerFingerprint        String
  fromRevision            Int
  toRevision              Int
  actorUserId             String?
  createdAt               DateTime @default(now())

  @@index([recommendationSessionId, createdAt])
  @@index([serviceOrderId, createdAt])
  @@index([infrastructureOrderId, createdAt])
}

model InfrastructureHealthCheck {
  id                       String                          @id @default(cuid())
  infrastructureOrderId    String
  cloudInstanceId          String
  attempt                  Int
  status                   InfrastructureHealthCheckStatus @default(RUNNING)
  providerState            String?
  expectedIpv4             String?
  observedIpv4             String?
  expectedNetworkId        String?
  observedNetworkId        String?
  expectedSecurityId       String?
  observedSecurityId       String?
  topologyVerificationMode String                          @default("STRICT_OBSERVED")
  providerObservedAt       DateTime?
  connectivityProtocol     String?
  resultCode               String?
  durationMs               Int?
  checkedAt                DateTime                        @default(now())
  finishedAt               DateTime?
  metadata                 Json?
  infrastructureOrder      InfrastructureOrder             @relation(fields: [infrastructureOrderId], references: [id], onDelete: Cascade)
  cloudInstance            CloudInstance                   @relation(fields: [cloudInstanceId], references: [id], onDelete: Cascade)

  @@unique([infrastructureOrderId, attempt])
  @@index([infrastructureOrderId, status, checkedAt])
  @@index([cloudInstanceId, checkedAt])
}

model SecureDeliveryEvent {
  id                    String               @id @default(cuid())
  infrastructureOrderId String
  cloudInstanceId       String
  status                SecureDeliveryStatus @default(PENDING)
  method                String
  resultCode            String?
  metadata              Json?
  deliveredAt           DateTime?
  createdAt             DateTime             @default(now())
  infrastructureOrder   InfrastructureOrder  @relation(fields: [infrastructureOrderId], references: [id], onDelete: Cascade)
  cloudInstance         CloudInstance        @relation(fields: [cloudInstanceId], references: [id], onDelete: Cascade)

  @@index([infrastructureOrderId, status, createdAt])
  @@index([cloudInstanceId, createdAt])
}
