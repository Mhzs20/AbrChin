  infrastructureOrderId    String
  cloudInstanceId          String
  attempt                  Int
  status                   InfrastructureHealthCheckStatus @default(RUNNING)
  providerState            String?
  expectedIpv4             String?
  observedIpv4             String?
  expectedNetworkId        String?
  observedNetworkId        String?
  expectedSecurityId       String?
  observedSecurityId       String?
  topologyVerificationMode String                          @default("STRICT_OBSERVED")
  providerObservedAt       DateTime?
  connectivityProtocol     String?
  resultCode               String?
  durationMs               Int?
  checkedAt                DateTime                        @default(now())
  finishedAt               DateTime?
